---
import AdminLayout from "../../layouts/AdminLayout.astro";
import PagesAdmin from "../../components/admin/PagesAdmin";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") || "";
---

<AdminLayout>
  <main class="mx-auto w-full max-w-4xl px-4 py-10">
    <h1 class="mb-1 text-2xl font-semibold">Contenu de recherche</h1>
    <p class="mb-8 text-sm text-muted-foreground">
      Édite le titre, le résumé et la catégorie utilisés pour la recherche. Les pages elles-mêmes
      sont synchronisées automatiquement depuis Webflow.
    </p>
    <PagesAdmin client:load base={base} />
  </main>
</AdminLayout>
