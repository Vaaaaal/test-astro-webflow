---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ActivityLogAdmin from "../../../components/admin/ActivityLogAdmin";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") || "";
---

<AdminLayout>
  <main class="mx-auto w-full max-w-5xl px-4 py-10">
    <p class="mb-8 text-sm text-muted-foreground">
      Historique des actions effectuées dans cette interface d'administration, mois par mois.
    </p>
    <ActivityLogAdmin client:load base={base} />
  </main>
</AdminLayout>
