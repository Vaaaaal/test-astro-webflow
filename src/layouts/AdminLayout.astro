---
import Layout from "./Layout.astro";
import { AdminShell } from "../components/AdminShell";

const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "") || "";
// Guaranteed non-null: this layout is only ever used under /admin, which
// the middleware requires a logged-in user (role >= editor) to reach.
const user = Astro.locals.user!;
const currentPath = Astro.url.pathname;
---

<Layout>
  <AdminShell client:load base={base} currentPath={currentPath} user={user}>
    <slot />
  </AdminShell>
</Layout>
